# AdmissionTimes web app configuration (copy to .env)

# Backend API base URL (required for production builds)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT_MS=15000

# Supabase (public anon key only — never the service role key)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_ENV=development
# Realtime notifications via Supabase postgres_changes
VITE_ENABLE_REALTIME=true
# University dashboard refresh interval (ms, minimum 15000)
VITE_DASHBOARD_POLL_MS=60000

# Debug logging in the browser console (development only)
VITE_DEBUG_AUTH=false
VITE_DEBUG_API=false
VITE_DEBUG_DASHBOARD=false

# UTC offset used when a date-only deadline is saved (end of that day). Pakistan: +05:00
VITE_APP_UTC_OFFSET=+05:00
